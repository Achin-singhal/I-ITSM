# ==============================================================================
# I-ITSM Environment Variables Template
# Reference template only. Spring Boot does not load a root .env automatically;
# export backend values in the backend process environment. Vite reads frontend/.env.
# Never commit actual secrets or production passwords.
# ==============================================================================

# --- Backend Configuration (Spring Boot) ---
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Supabase / PostgreSQL Database Connection
# Example URL for Supabase: jdbc:postgresql://db.<supabase_project_ref>.supabase.co:5432/postgres
DB_URL=jdbc:postgresql://localhost:5432/i_itsm_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_database_password
DB_SCHEMA=public

# Spring Security & JWT Settings
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
JWT_EXPIRATION_MS=86400000

# Local incident matching thresholds (unit interval, 0 < threshold <= 1)
DUPLICATE_SIMILARITY_THRESHOLD=0.62
RELATED_INCIDENT_THRESHOLD=0.35
RELATED_INCIDENT_WINDOW_DAYS=14

# SLA elapsed-time monitoring thresholds
SLA_MONITOR_INTERVAL_MS=30000
SLA_WARNING_THRESHOLD_PERCENT=0.20
SLA_ESCALATION_THRESHOLD_PERCENT=0.10

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend Configuration (Vite + React) ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_NAME="I-ITSM Incident Resolution System"
